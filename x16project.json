        ],
        "placement": {
          "target": "bank",
          "addr": "1",
          "loader": "One document. Chart sheets, bridge profiles, the p32/p16/p8 step-down sheets, and the zoom sheets export to the bank and VRAM files. Sheet ids are chart-*, bridge-*, p32-*, p16-*, p8-*, z32-*, z16-*, z8-*."
        },
        "resmap": [
          {
            "list": "vram",
            "file": "CHARGE.BIN",
            "size": 256,
            "kind": "RM_SPRITE"
          },
          {
            "list": "vram",
