{
  "comment": "Metadata for Project-X16. Not read by the build: the project's build scripts, x16cfg.h and vendor lock are the source of truth.",
  "schema": 2,
  "name": "convoy-x16",
  "displayName": "Convoy (X16)",
  "kind": "app",
  "genre": ["single-screen"],
  "elements": ["sprites", "pictures", "tiles", "sound", "text"],
  "targets": [
    {
      "id": "CONVOY",
      "prg": "build/CONVOY.PRG",
      "map": "build/CONVOY.map",
      "build": { "win": "build-win.cmd", "posix": "make", "cwd": "." },
      "variants": [
        {
          "id": "smoke",
          "args": "smoke",
          "prg": "build/SMOKE.PRG",
          "defines": ["CONVOY_SMOKE=1"]
        }
      ],
      "run": {
        "script": "run-win.cmd",
        "emuArgs": ["-scale", "2"],
        "fsroot": "boot"
      },
      "smoke": {
        "script": "smoke-win.cmd",
        "gif": "fixtures/smoke.gif",
        "seconds": 12,
        "fsroot": "boot"
      }
    }
  ],
  "lib": {
    "model": "c",
    "libPath": "../../x16-lib-poc",
    "modules": [
      "display",
      "fileio/file_load",
      "vera/vera_addr",
      "vera/vera_addr16",
      "layers/layer_config_tile",
      "layers/layer_enable_in_dc",
      "layers/layer_scroll",
      "audio/psg_core"
    ],
    "source": ["build-win.cmd:X16LIB_MODULES", "Makefile:X16LIB_MODULES"]
  },
  "config": {
    "cfgHeader": "src/x16cfg.h",
    "flags": { "X16_NO_SPRITE_POOL": 1 },
    "defines": ["X16LIB_HAVE_CFG"],
    "cpu": "6502"
  },
  "budgets": {
    "prgMax": 36864,
    "forbid": ["sprite_pool.o", "sprites.o"]
  },
  "notes": "One sprite document, assets/sprites/game.x16spr.json, holds every in-game sprite: chart hulls, bridge profiles, zoom steps, scopes, gauges, weapons, and marks. Pictures in this same project are the escort bow, the U-boat bow, the title card, and the credits card (assets/pictures). Sea tiles are assets/tiles/sea.x16tile.json. Palette is assets/palettes/main.x16pal.json. The plan is docs/game-plan.md.",
  "resources": {
    "palettes": [
      {
        "id": "main",
        "type": "palette",
        "doc": "assets/palettes/main.x16pal.json",
        "tool": "pixel",
        "outputs": [{ "file": "boot/PAL.BIN", "bytes": 64 }],
        "placement": { "target": "vram", "addr": "0x1FA00", "loader": "file_load (FILE_TO_VRAM)" }
      }
    ],
    "tiles": [
      {
        "id": "sea",
        "type": "tiles",
        "doc": "assets/tiles/sea.x16tile.json",
        "tool": "pixel",
        "exporter": "pixel-cli export-tiles",
        "outputs": [{ "file": "boot/TILES.BIN", "bytes": 768 }],
        "placement": { "target": "vram", "addr": "0x00000", "loader": "file_load (FILE_TO_VRAM)" }
      }
    ],
    "pictures": [
      {
        "id": "bowesc",
        "type": "picture",
        "doc": "assets/pictures/bowesc.x16pic.json",
        "tool": "pixel",
        "exporter": "pixel-cli export-picture",
        "outputs": [{ "file": "boot/bowesc.bin" }, { "file": "boot/bowmap.bin" }],
        "placement": { "target": "vram", "addr": "0x14000", "loader": "file_load. Layer 1 on the bridge. Map at $10000 is shared with bowubt." }
      },
      {
        "id": "bowubt",
        "type": "picture",
        "doc": "assets/pictures/bowubt.x16pic.json",
        "tool": "pixel",
        "exporter": "pixel-cli export-picture",
        "outputs": [{ "file": "boot/bowubt.bin" }],
        "placement": { "target": "vram", "addr": "0x14000", "loader": "file_load over the escort bow when the player is the boat" }
      },
      {
        "id": "title",
        "type": "picture",
        "doc": "assets/pictures/title.x16pic.json",
        "tool": "pixel",
        "exporter": "pixel-cli export-picture",
        "outputs": [{ "file": "boot/title.bin", "bytes": 76800 }],
        "placement": { "target": "vram", "addr": "0x00000", "loader": "file_load. Layer 0 bitmap, title phase only. 2bpp because a 4bpp 640x480 picture does not fit VERA." }
      },
      {
        "id": "credits",
        "type": "picture",
        "doc": "assets/pictures/credits.x16pic.json",
        "tool": "pixel",
        "exporter": "pixel-cli export-picture",
        "outputs": [{ "file": "boot/credits.bin", "bytes": 76800 }],
        "placement": { "target": "vram", "addr": "0x00000", "loader": "file_load over the title card. Credits phase only." }
      }
    ],
    "sprites": [
      {
        "id": "game",
        "type": "sprites",
        "doc": "assets/sprites/game.x16spr.json",
        "tool": "pixel",
        "exporter": "pixel-cli export",
        "outputs": [
          { "file": "boot/escort.bin", "bytes": 32768 },
          { "file": "boot/merchant.bin", "bytes": 32768 },
          { "file": "boot/tanker.bin", "bytes": 32768 },
          { "file": "boot/uboat.bin", "bytes": 32768 },
          { "file": "boot/wake.bin", "bytes": 32768 },
          { "file": "boot/profesc.bin", "bytes": 32768 },
          { "file": "boot/profmer.bin", "bytes": 32768 },
          { "file": "boot/proftnk.bin", "bytes": 32768 },
          { "file": "boot/profubt.bin", "bytes": 32768 },
          { "file": "boot/zoom.bin", "bytes": 2560 },
          { "file": "boot/marks.bin", "bytes": 256 },
          { "file": "boot/cross.bin", "bytes": 2048 },
          { "file": "boot/scope.bin", "bytes": 4992 },
          { "file": "boot/gauges.bin", "bytes": 6656 },
          { "file": "boot/weapons.bin", "bytes": 4608 },
          { "file": "boot/mid.bin", "bytes": 32768 },
          { "file": "boot/midwake.bin", "bytes": 8192 },
          { "file": "boot/tiny.bin", "bytes": 8192 },
          { "file": "boot/tinywake.bin", "bytes": 2048 },
          { "file": "boot/charge.bin", "bytes": 4096 },
          { "file": "boot/numbers.bin", "bytes": 640 }
        ],
        "placement": { "target": "bank", "addr": "1", "loader": "One document. Chart sheets, bridge profile sheets, and the zoom sheets export to the bank and VRAM files. Sheet ids are chart-*, bridge-*, z32-*, z16-*, z8-*." }
      }
    ],
    "sounds": [
      {
        "id": "sfx",
        "type": "sounds",
        "doc": "assets/sounds/sfx.x16snd.json",
        "tool": "sound",
        "exporter": "sound-cli export",
        "outputs": [
          { "file": "build/gen/sfx_ids.h" },
          { "file": "build/gen/sfx_sfx.h" }
        ],
        "placement": {
          "target": "code",
          "loader": "sfx_sfx.h included from src/platform.c, then x16lib/sfx.h. Voice 0 is the drone and is not in this table."
        }
      }
    ]
  }
}
