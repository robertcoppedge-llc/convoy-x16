  "targets": [
    {
      "id": "CONVOY",
      "prg": "build/CONVOY.PRG",
      "map": "build/CONVOY.map",
      "build": {
        "win": "build-win.cmd",
        "posix": "make",
        "cwd": "."
      },
      "variants": [
        {
          "id": "smoke",
          "args": "smoke",
          "prg": "build/SMOKE.PRG",
          "defines": [
            "CONVOY_SMOKE=1"
          ]
        }
      ],
      "run": {
        "script": "run-win.cmd",
        "emuArgs": [
          "-scale",
          "2"
        ],
        "fsroot": "boot"
      },
      "smoke": {
        "script": "smoke-win.cmd",
        "gif": "fixtures/smoke.gif",
        "seconds": 12,
        "fsroot": "boot"
      }
    }
  ],
  "lib": {
    "model": "c",
    "libPath": "../x16-lib-poc",
    "modules": [
      "display",
      "fileio/file_load",
      "fileio/file_banks",
      "fileio/file_save",
      "fileio/config_load",
      "vera/vera_addr",
      "vera/vera_addr16",
      "vram/vram_upload",
      "tilemap/tilemap_stream",
      "layers/layer_config_tile",
      "layers/layer_config_bitmap",
      "layers/layer_enable_in_dc",
      "layers/layer_scroll",
      "audio/psg_core",
      "sprites/sprite_put",
      "sprites/sprite_hide",
      "sprites/sprite_enable",
      "bank/bank_jsr",
      "expansion/exp_uart",
      "expansion/netcard"
    ],
    "source": [
      "build-win.cmd:X16LIB_MODULES",
      "Makefile:X16LIB_MODULES"
    ]
  },
  "config": {
    "cfgHeader": "src/x16cfg.h",
    "flags": {
      "X16_NO_SPRITE_POOL": 1
    },
    "defines": [
      "X16LIB_HAVE_CFG"
    ],
    "cpu": "6502"
  },
  "options": {
    "file": "convoy.cfg",
    "version": 1,
    "fields": [
      { "name": "music", "type": "u8", "default": 1 },
      { "name": "sfx", "type": "u8", "default": 1 }
    ]
  },
  "budgets": {
    "prgMax": 36864,
    "forbid": [
      "sprite_pool.o",
      "sprites.o"
    ]
  },
  "resources": {
    "palettes": [
      {
        "id": "main",
        "type": "palette",
        "doc": "assets/palettes/main.x16pal.json",
        "tool": "pixel",
        "outputs": [
          {
            "file": "boot/PAL.BIN",
            "bytes": 64
          }
        ],
        "placement": {
          "target": "vram",
          "addr": "0x1FA00",
          "loader": "file_load (FILE_TO_VRAM)"
        },
        "resmap": [
          {
            "list": "palette",
            "file": "PAL.BIN",
            "row": 0,
            "rows": 2
          }
        ]
      }
    ],
    "tiles": [
      {
        "id": "sea",
        "type": "tiles",
        "doc": "assets/tiles/sea.x16tile.json",
        "tool": "pixel",
        "outputs": [
          {
            "file": "boot/TILES.BIN",
            "bytes": 768
          }
        ],
        "placement": {
          "target": "vram",
          "addr": "0x00000",
          "phases": ["play"],
          "loader": "file_load (FILE_TO_VRAM). Play only. The title and credits cards use this address in other phases."
        },
        "resmap": [
          {
            "list": "vram",
            "file": "TILES.BIN",
            "size": 768,
            "kind": "RM_TILES"
          }
        ],
        "exporter": "pixel-cli export-tiles"
      }
    ],
    "pictures": [
      {
        "id": "bowesc",
        "type": "picture",
        "doc": "assets/pictures/bowesc.x16pic.json",
        "tool": "pixel",
        "outputs": [
          {
            "file": "boot/BOWESC.BIN",
            "bytes": 15360
          },
          {
            "file": "boot/BOWMAP.BIN",
            "bytes": 16384
          }
        ],
        "placement": {
          "target": "vram",
          "addr": "0x14000",
          "share": "bow",
          "loader": "file_load, then tools/pack_bows.py. Pixel writes 15360 bytes; the pack step adds a blank tile, a sky tile, and a horizon tile, so the file on disk is 15456. The same step writes boot/BOWMAP.BIN (16384), which is not a Pixel export. One bow at a time, shared with bowubt. Map at $10000."
        },
        "resmap": [
          {
            "list": "vram",
            "file": "BOWESC.BIN",
            "size": 15360,
            "kind": "RM_TILES"
          }
        ],
        "exporter": "pixel-cli export-picture"
      },
      {
        "id": "bowubt",
        "type": "picture",
        "doc": "assets/pictures/bowubt.x16pic.json",
        "tool": "pixel",
        "outputs": [
          {
            "file": "boot/BOWUBT.BIN",
            "bytes": 15360
          }
        ],
        "placement": {
          "target": "vram",
          "addr": "0x14000",
          "share": "bow",
          "loader": "file_load over the escort bow when the player is the boat, then the same pack_bows.py step. Pixel writes 15360 bytes; the packed file is 15456."
        },
        "resmap": [
          {
            "list": "vram",
            "file": "BOWUBT.BIN",
            "size": 15360,
            "kind": "RM_TILES"
          }
        ],
        "exporter": "pixel-cli export-picture"
      },
      {
        "id": "title",
        "type": "picture",
        "doc": "assets/pictures/title.x16pic.json",
        "tool": "pixel",
        "outputs": [
          {
            "file": "boot/TITLE.BIN",
            "bytes": 76800
          }
        ],
        "placement": {
          "target": "vram",
          "addr": "0x00000",
          "phases": ["title"],
          "loader": "file_load. Layer 0 bitmap, title phase only. 2bpp because a 4bpp 640x480 picture does not fit VERA."
        },
        "resmap": [
          {
            "list": "vram",
            "file": "TITLE.BIN",
            "size": 76800,
            "kind": "RM_BITMAP"
          }
        ],
        "exporter": "pixel-cli export-picture"
      },
      {
        "id": "credits",
