{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "X16: build",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "build-win.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "cc65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "X16: build and run",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "build-win.cmd && run-win.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "close": false, "panel": "shared" },
      "problemMatcher": {
        "owner": "cc65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "X16: run",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "run-win.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "close": false, "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "X16: smoke test",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "smoke-win.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "cc65",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "X16: unit tests",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "test-win.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "gcc",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "X16: clean",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/d", "/c", "if exist build rmdir /s /q build & if exist boot rmdir /s /q boot"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
